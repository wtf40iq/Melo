{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Melo",
  "version": "0.9.5",
  "identifier": "com.skymywex.melo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Melo",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "center": true,
        "transparent": true,
        "dragDropEnabled": false,
        "label": "main",
        "shadow": true,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "wtf40iq",
    "shortDescription": "Плеер музыки ВКонтакте",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer.nsh"
      }
    }
  }
}